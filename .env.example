# TubeNotes AI Environment Configuration
# Copy this file to .env to configure your local environment

PORT=5000
NODE_ENV=development

# Simulated processing delay per step in milliseconds
MOCK_STEP_DELAY_MS=600

# ==============================================================================
# AI API KEYS
# ==============================================================================

# OpenRouter AI API (Recommended - Unified access to free & premium models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional alternative direct providers:
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
